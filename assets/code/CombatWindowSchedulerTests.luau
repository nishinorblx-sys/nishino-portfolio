local Scheduler = require(script.Parent.CombatWindowScheduler)

local a = Scheduler.New(0.05, 0)
local sample, closing = Scheduler.Step(a, 0.034, 0.034, 0.22, 0.04)
assert(not sample and not closing)
sample, closing = Scheduler.Step(a, 0.033, 0.067, 0.22, 0.04)
assert(sample and not closing)
assert(math.abs(a.Remainder - 0.017) < 0.0001)
sample, closing = Scheduler.Step(a, 0.033, 0.1, 0.22, 0.04)
assert(sample and not closing)
assert(a.Remainder < 0.0001)
sample, closing = Scheduler.Step(a, 0.41, 0.51, 0.22, 0.04)
assert(not sample and closing)
local b = Scheduler.New(0.05, 0.2)
sample, closing = Scheduler.Step(b, 0.1, 0.302, 0.3, 0.04)
assert(sample and closing and b.Samples == 2)
sample, closing = Scheduler.Step(b, 0.01, 0.31, 0.3, 0.04)
assert(not sample and closing)
local c = Scheduler.New(0.05, 0.1)
local dropped
sample, closing, dropped = Scheduler.Step(c, 0.165, 0.265, 0.4, 0.04)
assert(sample and dropped == 2 and c.Remainder < 0.05)
print("CombatWindowSchedulerTests passed")
