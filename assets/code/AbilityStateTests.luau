local State = require(script.Parent.CombatState)
local Config = require(script.Parent.CombatConfig)

local model = Instance.new("Model")
model.Name = "AbilityStateTest"
model.Parent = workspace
State.SetEssence(model, 50)

local now = os.clock()
local token = State.BeginAbility(model, 1.1, 15, now)
assert(token ~= nil)
assert(State.GetEssence(model) == 35)
assert(State.BeginAbility(model, 1.1, 15, now) == nil)
assert(State.BeginAttack(model, "Light", Config.Weapons.TrainingSword, now) == nil)
assert(not State.BeginGuard(model, now))
assert(State.IsAbilityCurrent(model, token, now))
assert(State.OpenAbilityWindow(model, token, now + 0.1, 0.2))
assert(not State.OpenAbilityWindow(model, token, now + 0.11, 0.2))
assert(State.IsActive(model, now + 0.15))
assert(State.EndAbility(model, token, now + 0.5, 0.2))
assert(not State.IsAbilityCurrent(model, token, now + 0.5))
assert(not State.CanAttack(model, now + 0.55))
assert(State.CanAttack(model, now + 0.75))
local second = State.BeginAbility(model, 1.1, 30, now + 0.76)
assert(second ~= nil)
State.Interrupt(model, now + 1.5)
assert(not State.IsAbilityCurrent(model, second, now + 1))
assert(not State.EndAbility(model, second, now + 1, 0.2))
State.RefundEssence(model, 30)
assert(State.GetEssence(model) == 35)
State.Cleanup(model)
model:Destroy()
print("AbilityStateTests passed")
